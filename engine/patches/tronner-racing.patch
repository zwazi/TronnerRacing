+    md5_state_t state;
+    md5_byte_t digest[16];
+    md5_init( &state );
+    for ( sg_ReplaySettings::const_iterator item = settings.begin(); item != settings.end(); ++item )
+    {
+        sg_ReplayMD5Append( state, item->first );
+        sg_ReplayMD5Append( state, item->second );
+    }
+    md5_finish( &state, digest );
+
+    static char const digits[] = "0123456789abcdef";
+    tString result( "s1-" );
+    for ( int index = 0; index < 16; ++index )
+        result << digits[digest[index] >> 4] << digits[digest[index] & 15];
+    return result;
+}
+
+static sg_ReplaySettings sg_ReadReplaySettings()
+{
+    sg_ReplaySettings settings;
+    settings.push_back( sg_ReplaySetting( "__SNAPSHOT_FORMAT__", "1" ) );
+
+    tConfItemBase::tConfItemMap const & items = tConfItemBase::GetConfItemMap();
+    for ( tConfItemBase::tConfItemMap::const_iterator cursor = items.begin();
+          cursor != items.end(); ++cursor )
+    {
+        tConfItemBase * item = cursor->second;
+        std::string name( static_cast<char const *>( cursor->first ) );
+        if ( !item || !item->CanSave() || dynamic_cast<tConfItemFunc *>( item ) ||
+             sg_ReplaySettingSensitive( name ) )
+            continue;
+
+        std::ostringstream value;
+        item->WriteVal( value );
+        settings.push_back( sg_ReplaySetting( name, value.str() ) );
+    }
+    std::sort( settings.begin(), settings.end() );
+    return settings;
+}
+
+static void sg_WriteCycleReplaySettingsIfChanged( REAL gameTime, bool force, bool resend = false )
+{
+    if ( sn_GetNetState() != nSERVER )
+        return;
+
+    unsigned long long revision = tConfItemBase::ChangeRevision();
+    if ( !force && revision == sg_replaySettingsRevision )
+        return;
+    sg_replaySettingsRevision = revision;
+
+    sg_ReplaySettings settings = sg_ReadReplaySettings();
+    tString identifier = sg_ReplaySettingsIdentifier( settings );
+    if ( identifier == sg_activeReplaySettings && !resend )
+        return;
+
+    std::string identifierString( static_cast<char const *>( identifier ) );
+    bool newlyEmitted = sg_emittedReplaySettings.insert( identifierString ).second;
+    if ( resend || newlyEmitted )
+    {
+        se_cycleReplaySettingsWriter << "BEGIN" << identifier << 1 << settings.size();
+        se_cycleReplaySettingsWriter.write();
+        for ( sg_ReplaySettings::const_iterator item = settings.begin(); item != settings.end(); ++item )
+        {
+            se_cycleReplaySettingsWriter << "ITEM" << identifier <<
+                sg_ReplayHex( item->first ) << sg_ReplayHex( item->second );
+            se_cycleReplaySettingsWriter.write();
+        }
+        se_cycleReplaySettingsWriter << "END" << identifier << settings.size();
+        se_cycleReplaySettingsWriter.write();
+    }
+
+    sg_activeReplaySettings = identifier;
+    se_cycleReplaySettingsWriter << "ACTIVE" << identifier <<
+        sg_HighPrecisionRaceTime( gameTime );
+    se_cycleReplaySettingsWriter.write();
+}
+
+static void sg_ReplaySettingsSnapshotCommand( std::istream & )
+{
+    sg_WriteCycleReplaySettingsIfChanged( se_GameTime(), true, true );
+}
+
+static tConfItemFunc sg_replaySettingsSnapshotConf(
+    "CYCLE_REPLAY_SETTINGS_SNAPSHOT", &sg_ReplaySettingsSnapshotCommand );
+
+void gCycle::RecordReplaySettingsChange( REAL gameTime )
+{
+    sg_WriteCycleReplaySettingsIfChanged( gameTime, false );
+}
+
+static tString sg_HighPrecisionRaceTime( REAL time )
+{
+    std::ostringstream stream;
+    stream.precision( std::numeric_limits<REAL>::max_digits10 );
+    stream << time;
+    return tString( stream.str().c_str() );
+}
+
+static bool sg_CycleReplayEligible( const gCycle *cycle )
+{
+    return sn_GetNetState() == nSERVER && cycle && cycle->ReplayToken() > 0 &&
+        cycle->Player() && cycle->Player()->IsHuman();
+}
+
+static void sg_WriteCycleReplayState(
+    const gCycle *cycle, const char *kind, REAL gameTime )
+{
+    if ( !sg_CycleReplayEligible(cycle) )
+        return;
+    se_cycleReplayStateWriter << cycle->ReplayToken() << kind <<
+        sg_HighPrecisionRaceTime(gameTime) <<
+        cycle->MapPosition().x << cycle->MapPosition().y <<
+        cycle->Direction().x << cycle->Direction().y <<
+        cycle->Speed() << cycle->GetTurns() << cycle->GetDistance();
+    se_cycleReplayStateWriter.write();
+}
+
+static void sg_WriteCycleReplayInput(
+    const gCycle *cycle, REAL gameTime, const char *action )
+{
+    if ( !sg_CycleReplayEligible(cycle) )
+        return;
+    se_cycleReplayInputWriter << cycle->ReplayToken() <<
+        sg_HighPrecisionRaceTime(gameTime) << action <<
+        cycle->MapPosition().x << cycle->MapPosition().y <<
+        cycle->Direction().x << cycle->Direction().y <<
+        cycle->Speed() << cycle->GetTurns();
+    se_cycleReplayInputWriter.write();
+}
 
