+}
+
+void gCycle::StartBraked(REAL releaseAfterSeconds) {
+    if (!Alive())
+        return;
+    if (currentWall)
+        DropWall(false);
+
+    if (freezeClientZeroAcceleration_)
+    {
+        sg_ReleaseClientZeroAcceleration(Owner());
+        freezeClientZeroAcceleration_ = false;
+    }
+
+    freezeUntil_ = -1;
+    freezeReleaseStart_ = -1;
+    freezeReleaseUntil_ = -1;
+    freezeUntilBrake_ = false;
+    freezePosition_ = pos;
+    freezeDirection_ = dirDrive;
+    freezeStartHoldTurns_ = true;
+    freezeBrakeActionDown_ = false;
+    startBraked_ = true;
+    startBrakeReleaseTime_ = -1;
+    startBrakeReleaseSpeed_ = verletSpeed_;
+    if (std::isfinite(releaseAfterSeconds) && releaseAfterSeconds >= 0)
+        startBrakeReleaseTime_ = se_GameTime() + releaseAfterSeconds;
+
+    unsigned short oldBraking = braking;
+    braking = 1;
+    brakingReservoir = 1;
+    verletSpeed_ = 0;
+    acceleration = 0;
+    lastTimestep_ = 0;
+    lastMovementStartPosition_ = pos;
+    lastMovementStartTime_ = lastTime;
+    lastMovementValid_ = false;
+    correctPosSmooth = eCoord(0, 0);
+    correctDistanceSmooth = 0;
+    lastGoodPosition_ = pos;
+    predictPosition_ = pos;
+    if (braking != oldBraking)
+        OnBrakeStateChanged(se_GameTime(), braking);
+    sg_WriteCycleReplayState(this, "brake_hold", se_GameTime());
+    RequestSyncOwner();
+    RequestSyncAll();
+}
+
+void gCycle::RestoreCheckpointState(REAL speed, unsigned short turnCount) {
+    if (!std::isfinite(speed) || speed < 0)
+        speed = 0;
+    verletSpeed_ = speed;
+    freezeSpeed_ = speed;
+    turns = turnCount;
+    sg_WriteCycleReplayState(this, "restore", se_GameTime());
+    RequestSyncOwner();
+    RequestSyncAll();
+}
