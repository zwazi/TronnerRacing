+// Legacy clients predict their own cycle between authoritative syncs. A
+// zero-speed cycle therefore creeps forward when CYCLE_SPEED_DECAY_BELOW is
+// positive, then snaps back on every freeze sync. The network configuration
+// protocol can send a setting to one peer, so suppress only that peer's
+// below-base-speed prediction while its cycle is frozen. Server physics keep
+// using the real value throughout.
+static int sg_clientZeroAccelerationHolds[MAXCLIENTS + 2] = {};
+static nVersionFeature sg_clientZeroAccelerationFeature(8);
+
+static void sg_SendClientSpeedDecayBelow(int client, REAL value)
+{
+    REAL const authoritative = sg_speedCycleDecayBelow;
+    sg_speedCycleDecayBelow = value;
+    c_sdb.GetSetting().SendConfig(true, client);
+    sg_speedCycleDecayBelow = authoritative;
+}
+
+bool sg_AcquireClientZeroAcceleration(int client)
+{
+    if (sn_GetNetState() != nSERVER || client <= 0 || client > MAXCLIENTS ||
+            !sn_Connections[client].socket ||
+            !sg_clientZeroAccelerationFeature.Supported(client))
+        return false;
+
+    if (sg_clientZeroAccelerationHolds[client]++ == 0)
+        sg_SendClientSpeedDecayBelow(client, 0);
+    return true;
+}
+
+void sg_ReleaseClientZeroAcceleration(int client)
+{
+    if (client <= 0 || client > MAXCLIENTS ||
+            sg_clientZeroAccelerationHolds[client] <= 0)
+        return;
+
+    if (--sg_clientZeroAccelerationHolds[client] == 0 &&
+            sn_GetNetState() == nSERVER && sn_Connections[client].socket)
+        c_sdb.GetSetting().SendConfig(true, client);
+}
+
+void sg_CancelClientZeroAcceleration(int client)
+{
+    if (client <= 0 || client > MAXCLIENTS ||
+            sg_clientZeroAccelerationHolds[client] <= 0)
+        return;
+
+    sg_clientZeroAccelerationHolds[client] = 0;
+    if (sn_GetNetState() == nSERVER && sn_Connections[client].socket)
+        c_sdb.GetSetting().SendConfig(true, client);
+}
+
+bool sg_ClientZeroAccelerationActive(int client)
+{
+    return client > 0 && client <= MAXCLIENTS &&
+           sg_clientZeroAccelerationHolds[client] > 0;
+}
