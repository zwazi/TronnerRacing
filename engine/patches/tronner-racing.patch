+
+static void sg_PlayerPrivateZones(std::istream &s)
+{
+    tString value;
+    value.ReadLine(s, true);
+    std::string serialized(static_cast<const char *>(value));
+    for (std::string::size_type i = 0; i < serialized.size(); ++i)
+    {
+        if (serialized[i] == ',' || serialized[i] == ';')
+        {
+            serialized[i] = ' ';
+        }
+    }
+
+    std::stringstream values(serialized);
+    int ordinal = 0;
+    while (values >> ordinal)
+    {
+        if (ordinal > 0)
+        {
+            sg_playerPrivateZoneOrdinals.insert(ordinal);
+        }
+    }
+}
