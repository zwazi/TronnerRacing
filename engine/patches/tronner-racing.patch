+static constexpr bool sg_ConsumeBrakedStartDestination(
+    bool turnCountAdvanced, bool clientBrakeWasDown, bool clientBrakeDown)
+{
+    // A turn carrying the client's pre-sync brake-off state is only a turn.
+    // Once brake-down has been reported, a combined turn/brake-off packet is
+    // the real release and must retain its stock simulation timestamp.
+    return turnCountAdvanced && !(clientBrakeWasDown && !clientBrakeDown);
+}
+
+static_assert(sg_ConsumeBrakedStartDestination(true, false, false),
+              "a pre-brake turn must stay held");
+static_assert(sg_ConsumeBrakedStartDestination(true, false, true),
+              "a turn that establishes brake-down must stay held");
+static_assert(!sg_ConsumeBrakedStartDestination(true, true, false),
+              "a combined turn and brake release must keep native timing");
+static_assert(!sg_ConsumeBrakedStartDestination(false, false, false),
+              "a brake-only release must keep native timing");
+
+bool gCycle::HandleStartHoldDestination(const gDestination &destination)
+{
+    if (sn_GetNetState() != nSERVER || !freezeStartHoldTurns_ ||
+            (!IsFrozen(se_GameTime()) && !startBraked_))
+        return false;
+
+    // A client sends turns as destinations. Only an advancing turn counter is
+    // proof of a turn: brake-only destinations can contain a slightly
+    // different direction vector and must never rotate the held cycle.
+    bool turnCountAdvanced = destination.turns != 0 &&
+        static_cast<short>(destination.turns - turns) > 0;
+    bool consumeBrakedStartDestination = false;
+    if (startBraked_)
+    {
+        bool clientBrakeWasDown = freezeBrakeActionDown_;
+        freezeBrakeActionDown_ = destination.braking;
+        consumeBrakedStartDestination = sg_ConsumeBrakedStartDestination(
+            turnCountAdvanced, clientBrakeWasDown, destination.braking);
+    }
+    if (turnCountAdvanced)
+    {
+        int winding = Grid()->DirectionWinding(destination.direction);
+        ApplyStartHoldDirection(winding, destination.turns);
+
+        // This turn is applied here rather than entering the normal movement
+        // queue. Acknowledge the turn itself so the owner cannot replay it
+        // after launch, but leave the brake packet to the original path.
+        if ((!startBraked_ || consumeBrakedStartDestination) &&
+                destination.messageID > 1 &&
+                (lastStartHoldMessageID_ <= 1 ||
+                 static_cast<short>(destination.messageID -
+                                    lastStartHoldMessageID_) > 0))
+            lastStartHoldMessageID_ = destination.messageID;
+    }
+
+    if (startBraked_)
+    {
+        // Turns are consumed above so they cannot replay after launch. Leave
+        // the stock brake-off destination on the ordinary movement path: all
+        // 0.2.8+ clients already synchronize that state and its input time.
+        return consumeBrakedStartDestination;
+    }
+
+    if (freezeUntilBrake_)
+    {
+        bool down = destination.braking;
+        bool brakeChanged = down != freezeBrakeActionDown_;
+        freezeBrakeActionDown_ = down;
+        if (brakeChanged)
+        {
+            freezeUntilBrake_ = false;
+            freezeUntil_ = se_GameTime();
+            braking = 0;
+            RequestSyncOwner();
+            RequestSyncAll();
+        }
+    }
+
+    // Consume the destination here so its frozen turn or starting brake action
+    // is not replayed by the normal movement simulation after release.
+    return true;
+}
+
+void gCycle::ApplyStartHoldDirection(int winding, unsigned short turnCount)
+{
+    eCoord heldDirection = Grid()->GetDirection(winding);
+    SetWindingNumberWrapped(winding);
+    freezeDirection_ = heldDirection;
+    dirDrive = heldDirection;
+    dir = heldDirection;
+    lastDirDrive = heldDirection;
+    lastTurnPos_ = freezePosition_;
+    turns = turnCount;
+    lastPlayerTurnTime_ = se_GameTime();
+    pendingTurns.clear();
+    refreshSpaceAhead_ = true;
+    correctPosSmooth = eCoord(0, 0);
+    correctDistanceSmooth = 0;
+    RequestSyncOwner();
+    RequestSyncAll();
+}
+
+void gCycle::TurnDuringStartHold(int direction)
+{
+    int winding = windingNumberWrapped_;
+    Grid()->Turn(winding, direction);
+    ApplyStartHoldDirection(
+        winding, static_cast<unsigned short>(turns + 1));
+}
