+    int user = player->Owner();
+    gRealColor color;
+    color.r = player->r / 15.0f;
+    color.g = player->g / 15.0f;
+    color.b = player->b / 15.0f;
+    tArray<gCheckpointZoneHack *> zones = sg_GetCheckpointZones();
+    for (int i = 0; i < zones.Len(); i++)
+    {
