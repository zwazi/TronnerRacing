+        {
+            knowsAbout[i].syncReq = false;
+            knowsAbout[i].nextSyncAck = false;
+        }
+    }
+}
+
+bool gZone::ShouldTransmitTo(int user) const
+{
+    return (!privateUser_ || privateUser_ == user) &&
+        eNetGameObject::ShouldTransmitTo(user);
+}
