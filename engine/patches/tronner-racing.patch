+REAL gCycle::ExactZoneEntryTime(const eCoord &center, REAL radius, REAL fallback) const {
+    if (!lastMovementValid_ || lastTime <= lastMovementStartTime_)
+        return fallback;
+
+    // Solve |start + u * (end - start) - center|^2 = radius^2.
+    // Double intermediates keep the sub-millisecond result stable even though
+    // the game's native coordinate and time type is REAL.
+    const double sx = static_cast<double>(lastMovementStartPosition_.x);
+    const double sy = static_cast<double>(lastMovementStartPosition_.y);
+    const double dx = static_cast<double>(pos.x) - sx;
+    const double dy = static_cast<double>(pos.y) - sy;
+    const double ox = sx - static_cast<double>(center.x);
+    const double oy = sy - static_cast<double>(center.y);
+    const double r = static_cast<double>(radius);
+    const double a = dx * dx + dy * dy;
+    const double b = 2.0 * (ox * dx + oy * dy);
+    const double c = ox * ox + oy * oy - r * r;
+
+    if (a <= 0.0 || c <= 0.0)
+        return fallback;
+
+    const double discriminant = b * b - 4.0 * a * c;
+    if (discriminant < 0.0)
+        return fallback;
+
+    const double root = sqrt(discriminant);
+    double u = (-b - root) / (2.0 * a);
+    if (u < 0.0 || u > 1.0)
+        u = (-b + root) / (2.0 * a);
+    if (u < 0.0 || u > 1.0)
+        return fallback;
+
+    const double startTime = static_cast<double>(lastMovementStartTime_);
+    const double endTime = static_cast<double>(lastTime);
+    return static_cast<REAL>(startTime + u * (endTime - startTime));
+}
