+void gCycle::FreezeFor(REAL seconds) {
+    if (!Alive())
+        return;
+    if (seconds <= 0) {
+        freezeUntil_ = -1;
+        freezeReleaseStart_ = -1;
+        freezeReleaseUntil_ = -1;
+        freezeUntilBrake_ = false;
+        freezeStartHoldTurns_ = false;
+        freezeBrakeActionDown_ = false;
+        verletSpeed_ = freezeSpeed_;
+        RequestSync();
+        if (freezeClientZeroAcceleration_)
+        {
+            sg_ReleaseClientZeroAcceleration(Owner());
+            freezeClientZeroAcceleration_ = false;
+        }
+        return;
+    }
+    if (!IsFrozen(se_GameTime()))
+    {
+        freezeSpeed_ = verletSpeed_;
+        bool otherLocalCycle = false;
+        for (int index = se_PlayerNetIDs.Len() - 1; index >= 0; --index)
+        {
+            ePlayerNetID * otherPlayer = se_PlayerNetIDs(index);
+            if (!otherPlayer || otherPlayer == Player() ||
+                    otherPlayer->Owner() != Owner())
+                continue;
+            gCycle * otherCycle = dynamic_cast<gCycle *>(otherPlayer->Object());
+            if (otherCycle && otherCycle->Alive())
+            {
+                otherLocalCycle = true;
+                break;
+            }
+        }
+        if (!otherLocalCycle && !freezeClientZeroAcceleration_)
+            freezeClientZeroAcceleration_ =
+                sg_AcquireClientZeroAcceleration(Owner());
+    }
+    freezeReleaseStart_ = -1;
+    freezeReleaseUntil_ = -1;
+    bool retainStartHoldTurns = freezeStartHoldTurns_;
+    freezePosition_ = pos;
+    freezeDirection_ = dirDrive;
+    freezeUntil_ = se_GameTime() + seconds;
+    freezeUntilBrake_ = false;
+    freezeStartHoldTurns_ = retainStartHoldTurns;
+    freezeBrakeActionDown_ = false;
+    verletSpeed_ = 0;
+    acceleration = 0;
+    lastTimestep_ = 0;
+    lastMovementStartPosition_ = pos;
+    lastMovementStartTime_ = lastTime;
+    lastMovementValid_ = false;
+    correctPosSmooth = eCoord(0, 0);
+    correctDistanceSmooth = 0;
+    lastGoodPosition_ = pos;
+    predictPosition_ = pos;
+    RequestSync();
+}
