+    // direction only after brake releases the cycle.
+    if (currentWall)
+        DropWall(false);
+    if (!IsFrozen(se_GameTime()))
+    {
+        freezeSpeed_ = verletSpeed_;
+        bool otherLocalCycle = false;
+        for (int index = se_PlayerNetIDs.Len() - 1; index >= 0; --index)
+        {
+            ePlayerNetID *otherPlayer = se_PlayerNetIDs(index);
+            if (!otherPlayer || otherPlayer == Player() ||
+                    otherPlayer->Owner() != Owner())
+                continue;
+            gCycle *otherCycle = dynamic_cast<gCycle *>(otherPlayer->Object());
+            if (otherCycle && otherCycle->Alive())
+            {
+                otherLocalCycle = true;
+                break;
+            }
+        }
+        if (!otherLocalCycle && !freezeClientZeroAcceleration_)
+            freezeClientZeroAcceleration_ =
+                sg_AcquireClientZeroAcceleration(Owner());
+    }
+    freezeReleaseStart_ = -1;
+    freezeReleaseUntil_ = -1;
+    freezePosition_ = pos;
+    freezeDirection_ = dirDrive;
+    freezeUntil_ = std::numeric_limits<REAL>::max();
+    freezeUntilBrake_ = true;
+    freezeStartHoldTurns_ = true;
+    freezeBrakeActionDown_ = braking != 0;
+    braking = 0;
+    verletSpeed_ = 0;
+    acceleration = 0;
+    lastTimestep_ = 0;
