+void gZone::ResetPrivateLifetime()
+{
+    if (!privateUser_)
+        return;
+
+    // Keep the same network object alive and only rebase its radius function.
+    // Recreating it causes stock clients to alternate between old and new zone
+    // objects; a targeted sync gives the owner one continuous, smooth zone.
+    SetReferenceTime();
+    SetRadius(privateInitialRadius_);
+    SetExpansionSpeed(privateInitialExpansionSpeed_);
+    resizeRequested_ = false;
+    RequestSync(privateUser_, true);
+}
+
+void sg_ResetPrivateZonesForUser(int user)
+{
+    if (user <= 0 || user > MAXCLIENTS)
+        return;
+    for (std::deque<gZone *>::iterator zone = sg_Zones.begin();
+         zone != sg_Zones.end(); ++zone)
+    {
+        if (*zone && (*zone)->PrivateUser() == user)
+            (*zone)->ResetPrivateLifetime();
+    }
+}
