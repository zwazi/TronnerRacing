+static constexpr int sg_PositiveModulo(int value, int modulus)
+{
+    return ((value % modulus) + modulus) % modulus;
+}
+
+static constexpr int sg_StartHoldTurnDistance(
+    int initialWinding, int currentWinding, int axes)
+{
+    return axes <= 0 ? 0 :
+        (sg_PositiveModulo(currentWinding - initialWinding, axes) <=
+         axes - sg_PositiveModulo(currentWinding - initialWinding, axes)
+         ? sg_PositiveModulo(currentWinding - initialWinding, axes)
+         : axes - sg_PositiveModulo(currentWinding - initialWinding, axes));
+}
+
