+bool gCycle::ClearToTransmit(int user) const
+{
+    // The owner has already predicted brake-off locally. During the existing
+    // chat/away confirmation window, acknowledging that input with a newer
+    // stopped/brake-on state undoes prediction and causes stop-then-jump.
+    // Temporarily defer only owner syncs; keep the queued latest state for
+    // release/cancellation. Creation, death and other viewers remain normal.
+    if (sn_GetNetState() == nSERVER && user == Owner() && Alive() &&
+            startBraked_ && startBrakeInput_.Pending() &&
+            HasBeenTransmitted(user))
+        return false;
+    return eNetGameObject::ClearToTransmit(user);
+}
