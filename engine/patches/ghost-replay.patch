+class gGhostPlayer: public ePlayerNetID
+{
+public:
+    gGhostPlayer( int recipient, tString const & name )
+        : ePlayerNetID(), recipient_(recipient), visible_(false)
+    {
+        r = 4;
+        g = 13;
+        b = 15;
+        SetName(name);
+    }
+
+    virtual bool IsHuman() const { return false; }
+    virtual bool IsServerGhost() const { return true; }
+    virtual bool ShouldTransmitTo(int user) const
+    {
+        return visible_ && user == recipient_;
+    }
+    virtual bool ClearToTransmit(int user) const
+    {
+        return ShouldTransmitTo(user) && ePlayerNetID::ClearToTransmit(user);
+    }
+    virtual nDescriptor &CreatorDescriptor() const
+    {
+        // Descriptor 201 is understood by unmodified 0.2.8 clients.
+        return ePlayerNetID::CreatorDescriptor();
+    }
