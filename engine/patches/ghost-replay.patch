+class gGhostCycle: public gCycle
+{
+public:
+    gGhostCycle(
+        eGrid *grid,
+        sg_GhostPlan const & plan,
+        gGhostPlayer *player,
+        gCycle *human,
+        sg_GhostSession *session )
+        : gCycle(grid, plan.position * gArena::SizeMultiplier(), plan.direction, player),
+          plan_(plan), recipient_(session->owner), visible_(false),
+          started_(false), complete_(false), nextEvent_(0),
+          playbackStart_(0), human_(human), session_(session)
+    {
+        RestoreCheckpointState(plan_.speed, plan_.turns);
+        SetWallBuilding(false);
+    }
+
+    virtual bool IsServerGhost() const { return true; }
+    virtual bool ShouldTransmitTo(int user) const
+    {
+        return visible_ && user == recipient_;
+    }
+    virtual nDescriptor &CreatorDescriptor() const
+    {
+        // Descriptor 320 and its payload stay byte-compatible with 0.2.8.
+        return gCycle::CreatorDescriptor();
+    }
+    virtual bool Vulnerable() const { return false; }
+    virtual void InteractWith(eGameObject *, REAL, int) {}
+    virtual void Kill() {}
+    virtual void OnRoundEnd() {}
+
+    virtual void WriteSync(nMessage &message)
+    {
+        // Legacy clients infer wall birth time from distance/speed on their
+        // first cycle sync. A large negative wire-only distance pushes that
+        // time beyond this bounded replay, preventing a predicted ghost wall
+        // from entering the requester's local collision grid.
+        REAL realDistance = distance;
+        distance = realDistance - 1000000;
+        gCycle::WriteSync(message);
+        distance = realDistance;
+    }
+
+    bool Complete() const { return complete_; }
+
+protected:
+    virtual bool TimestepCore(REAL currentTime, bool calculateAcceleration)
+    {
+        if ( complete_ )
+            return false;
+        if ( !human_ || !human_->Alive() || human_->Player() == 0 )
+        {
+            Finish();
+            return false;
+        }
+        if ( !started_ )
+        {
+            if ( human_->IsStartHeld(currentTime) )
+            {
+                lastTime = currentTime;
+                return false;
+            }
+            playbackStart_ = human_->RaceStartTime();
+            if ( playbackStart_ > currentTime )
+                playbackStart_ = currentTime;
+            lastTime = playbackStart_;
+            RestoreCheckpointState(plan_.speed, plan_.turns);
+            started_ = true;
+            visible_ = true;
+            gGhostPlayer *ghostPlayer =
+                dynamic_cast< gGhostPlayer * >(Player());
+            if ( ghostPlayer )
+                ghostPlayer->Reveal();
+            RequestSync(recipient_, true);
+        }
+
+        REAL finishTime = playbackStart_ +
+            static_cast<REAL>(plan_.durationUs) / 1000000.0;
+        REAL targetTime = currentTime < finishTime ? currentTime : finishTime;
+        while ( nextEvent_ < plan_.events.size() )
+        {
+            sg_GhostEvent const &event = plan_.events[nextEvent_];
+            REAL eventTime = playbackStart_ +
+                static_cast<REAL>(event.offsetUs) / 1000000.0;
+            if ( eventTime > targetTime )
+                break;
+            if ( eventTime > lastTime &&
+                    gCycle::TimestepCore(eventTime, calculateAcceleration) )
+            {
+                Finish();
+                return false;
+            }
+            if ( event.action == 0 )
+                ReplayTurn(-1);
+            else if ( event.action == 1 )
+                ReplayTurn(1);
+            else if ( event.action == 2 )
+                gCycle::Act(&gCycle::s_brake, 0);
+            else if ( event.action == 3 )
+                gCycle::Act(&gCycle::s_brake, 1);
+            // Captured turns were accepted by the authoritative server. Do
+            // not let a replay-time timing edge leave one queued to execute
+            // later as an apparent extra turn.
+            pendingTurns.clear();
+            if ( event.hasState && event.action <= 1 )
+                RestoreReplayEventState(
+                    event.position * gArena::SizeMultiplier(),
+                    event.direction, event.speed, event.turns,
+                    event.action == 0 ? -1 : 1 );
+            ++nextEvent_;
+        }
+        if ( targetTime > lastTime &&
+                gCycle::TimestepCore(targetTime, calculateAcceleration) )
+        {
+            Finish();
+            return false;
+        }
+        SetWallBuilding(false);
+        RequestSync(recipient_, false);
+        if ( currentTime >= finishTime )
+            Finish();
+        return false;
+    }
+
+private:
+    void ReplayTurn(int direction)
+    {
+        // The source event was logged only after the authoritative server
+        // accepted it. Execute it at that exact recorded time even if float
+        // rounding would otherwise put it just inside the delay window.
+        pendingTurns.clear();
+        REAL previousLeft = lastTurnTimeLeft_;
+        REAL previousRight = lastTurnTimeRight_;
+        lastTurnTimeLeft_ = -std::numeric_limits<REAL>::max() / 4;
+        lastTurnTimeRight_ = lastTurnTimeLeft_;
+        gCycle::DoTurn(direction);
+        pendingTurns.clear();
+        if ( direction < 0 )
+            lastTurnTimeRight_ = previousRight;
+        else
+            lastTurnTimeLeft_ = previousLeft;
+    }
+
+    void Finish()
+    {
+        if ( complete_ )
+            return;
+        complete_ = true;
+        if ( session_ )
+            session_->complete = true;
+        if ( !sg_ghostSweepScheduled )
+        {
+            sg_ghostSweepScheduled = true;
+            st_ToDo(sg_GhostSweep);
+        }
+    }
+
+    sg_GhostPlan plan_;
+    int recipient_;
+    bool visible_;
+    bool started_;
+    bool complete_;
+    std::size_t nextEvent_;
+    REAL playbackStart_;
+    nObserverPtr< gCycle > human_;
+    sg_GhostSession *session_;
+};
+
+static void sg_DestroyGhostSession(int owner)
+{
+    std::map< int, sg_GhostSession * >::iterator found =
+        sg_ghostSessions.find(owner);
+    if ( found == sg_ghostSessions.end() )
+        return;
+    sg_GhostSession *session = found->second;
+    sg_ghostSessions.erase(found);
+    if ( session->cycle )
+        session->cycle->RemoveFromGame();
+    if ( session->player )
+        session->player->RemoveFromGame();
+    session->cycle = 0;
+    session->player = 0;
+    delete session;
+}
+
+static void sg_GhostSweep()
+{
+    sg_ghostSweepScheduled = false;
+    std::vector< int > completed;
+    for ( std::map< int, sg_GhostSession * >::const_iterator cursor =
+              sg_ghostSessions.begin(); cursor != sg_ghostSessions.end(); ++cursor )
+        if ( cursor->second && cursor->second->complete )
+            completed.push_back(cursor->first);
+    for ( std::vector< int >::const_iterator owner = completed.begin();
+          owner != completed.end(); ++owner )
+        sg_DestroyGhostSession(*owner);
+}
+
+static bool sg_GhostSafeFilename(std::string const &filename)
+{
+    if ( filename.size() < 7 || filename.size() > 128 || filename[0] == '.' )
+        return false;
+    for ( std::string::const_iterator character = filename.begin();
+          character != filename.end(); ++character )
+        if ( !std::isalnum(static_cast<unsigned char>(*character)) &&
+             *character != '-' && *character != '.' )
+            return false;
+    return filename.compare(filename.size() - 5, 5, ".plan") == 0;
+}
+
+static bool sg_GhostDecodeHex(std::string const &encoded, tString &decoded)
+{
+    if ( encoded == "-" )
+    {
+        decoded = "Ghost";
+        return true;
+    }
+    if ( encoded.empty() || encoded.size() > 30 || encoded.size() % 2 )
+        return false;
+    std::string value;
+    for ( std::size_t index = 0; index < encoded.size(); index += 2 )
+    {
+        char *end = 0;
+        long byte = strtol(encoded.substr(index, 2).c_str(), &end, 16);
+        if ( !end || *end || byte < 32 || byte > 126 )
+            return false;
+        value.push_back(static_cast<char>(byte));
+    }
+    decoded = value.c_str();
+    return true;
+}
+
+static bool sg_ReadGhostPlan(
+    std::string const &filename, sg_GhostPlan &plan, std::string &error )
+{
+    if ( !sg_GhostSafeFilename(filename) )
+    {
+        error = "unsafe filename";
+        return false;
+    }
+    std::string directory(static_cast<char const *>(sg_ghostPlanDirectory));
+    if ( directory.empty() || directory.find("..") != std::string::npos )
+    {
+        error = "invalid plan directory";
+        return false;
+    }
+    std::string path = directory + "/" + filename;
+    std::ifstream input(path.c_str());
+    if ( !input )
+    {
+        error = "plan unavailable";
+        return false;
+    }
+
+    std::string key;
+    int format = 0;
+    std::string encodedName;
+    unsigned int eventCount = 0;
+    unsigned int turns = 0;
+    bool valid =
+        static_cast<bool>(input >> key >> format) && key == "TRONNER_GHOST" &&
+        (format == 1 || format == 2) &&
+        static_cast<bool>(input >> key >> plan.runId) && key == "RUN" && plan.runId > 0 &&
+        static_cast<bool>(input >> key >> encodedName) && key == "NAME" &&
+        sg_GhostDecodeHex(encodedName, plan.displayName) &&
+        static_cast<bool>(input >> key >> plan.durationUs) && key == "DURATION_US" &&
+        plan.durationUs > 0 && plan.durationUs <= sg_GhostMaxDurationUs &&
+        static_cast<bool>(input >> key >> plan.position.x >> plan.position.y >>
+                          plan.direction.x >> plan.direction.y >> plan.speed >> turns) &&
+        key == "START" && turns <= 65535 &&
+        static_cast<bool>(input >> key >> eventCount) && key == "EVENT_COUNT" &&
+        eventCount <= sg_GhostMaxEvents;
+    if ( valid )
+    {
+        plan.turns = static_cast<unsigned short>(turns);
+        valid = std::isfinite(plan.position.x) && std::isfinite(plan.position.y) &&
+            std::isfinite(plan.direction.x) && std::isfinite(plan.direction.y) &&
+            std::isfinite(plan.speed) && plan.speed > EPS &&
+            plan.direction.NormSquared() > EPS;
+    }
+    long long previousOffset = -1;
+    for ( unsigned int index = 0; valid && index < eventCount; ++index )
+    {
+        sg_GhostEvent event;
+        valid = static_cast<bool>(input >> key >> event.offsetUs >> event.action) &&
+            key == "EVENT" && event.offsetUs >= 0 &&
+            event.offsetUs >= previousOffset &&
+            event.offsetUs <= plan.durationUs + 1000000 &&
+            event.action >= 0 && event.action <= 3;
+        event.hasState = false;
+        if ( valid && format >= 2 )
+        {
+            unsigned int hasState = 0;
+            valid = static_cast<bool>(input >> hasState) && hasState <= 1;
+            event.hasState = hasState == 1;
+            if ( valid && event.hasState )
+            {
+                unsigned int stateTurns = 0;
+                valid = static_cast<bool>(input >> event.position.x >>
+                    event.position.y >> event.direction.x >> event.direction.y >>
+                    event.speed >> stateTurns) && stateTurns <= 65535;
+                if ( valid )
+                {
+                    event.turns = static_cast<unsigned short>(stateTurns);
+                    valid = std::isfinite(event.position.x) &&
+                        std::isfinite(event.position.y) &&
+                        std::isfinite(event.direction.x) &&
+                        std::isfinite(event.direction.y) &&
+                        std::isfinite(event.speed) && event.speed > EPS &&
+                        event.direction.NormSquared() > EPS;
+                }
+            }
+        }
+        if ( valid )
+        {
+            plan.events.push_back(event);
+            previousOffset = event.offsetUs;
+        }
+    }
+    std::string trailing;
+    if ( valid )
+        valid = static_cast<bool>(input >> trailing) && trailing == "END" &&
+            !(input >> key);
+    input.close();
+    std::remove(path.c_str());
+    if ( !valid )
+        error = "invalid plan";
+    return valid;
+}
+
+static void sg_AttachGhostToHuman(gCycle *human)
+{
+    if ( sn_GetNetState() != nSERVER || !human || !human->Player() ||
+         !human->Player()->IsHuman() || human->Player()->Owner() <= 0 )
+        return;
+    int owner = human->Player()->Owner();
+    std::map< int, sg_GhostPlan >::const_iterator found = sg_ghostPlans.find(owner);
+    if ( found == sg_ghostPlans.end() ||
+         found->second.requesterName != human->Player()->GetLogName() )
+        return;
+
+    sg_DestroyGhostSession(owner);
+    sg_GhostSession *session = new sg_GhostSession(owner);
+    session->player = new gGhostPlayer(owner, found->second.displayName);
+    session->cycle = new gGhostCycle(
+        human->Grid(), found->second, session->player, human, session );
+    session->player->ControlObject(session->cycle);
+    sg_ghostSessions[owner] = session;
+}
+
+static void sg_GhostLoad(std::istream &stream)
+{
+    ePlayerNetID *requester = ePlayerNetID::ReadPlayer(stream);
+    tString filename;
+    stream >> filename;
+    if ( filename.Len() <= 1 )
+        return;
+    sg_GhostPlan plan;
+    std::string error;
+    if ( !sg_ReadGhostPlan(static_cast<char const *>(filename), plan, error) )
+    {
+        con << "Rejected ghost plan";
+        if ( requester )
+            con << " for " << requester->GetLogName();
+        con << ": " << error.c_str() << "\n";
+        return;
+    }
+    // The plan is one-shot and has already been removed by the parser. Bind
+    // it only if the requester still exists on the expected client slot.
+    if ( !requester || !requester->IsHuman() || requester->Owner() <= 0 )
+        return;
+    plan.requesterName = requester->GetLogName();
+    sg_ghostPlans[requester->Owner()] = plan;
+    sg_DestroyGhostSession(requester->Owner());
+}
+
+static void sg_GhostClear(std::istream &stream)
+{
+    ePlayerNetID *requester = ePlayerNetID::ReadPlayer(stream);
+    if ( !requester || requester->Owner() <= 0 )
+        return;
+    sg_ghostPlans.erase(requester->Owner());
+    sg_DestroyGhostSession(requester->Owner());
+}
+
+static void sg_GhostClearAll(std::istream &)
+{
+    std::vector< int > owners;
+    for ( std::map< int, sg_GhostSession * >::const_iterator cursor =
+              sg_ghostSessions.begin(); cursor != sg_ghostSessions.end(); ++cursor )
+        owners.push_back(cursor->first);
+    for ( std::vector< int >::const_iterator owner = owners.begin();
+          owner != owners.end(); ++owner )
+        sg_DestroyGhostSession(*owner);
+    sg_ghostPlans.clear();
+}
+
+static void sg_GhostConnectionChanged()
+{
+    if ( !nCallbackLoginLogout::Login() )
+    {
+        int owner = nCallbackLoginLogout::User();
+        sg_ghostPlans.erase(owner);
+        sg_DestroyGhostSession(owner);
+    }
+}
+
+static tConfItemFunc sg_ghostLoadConf("GHOST_LOAD", &sg_GhostLoad);
+static tConfItemFunc sg_ghostClearConf("GHOST_CLEAR", &sg_GhostClear);
+static tConfItemFunc sg_ghostClearAllConf("GHOST_CLEAR_ALL", &sg_GhostClearAll);
+static nCallbackLoginLogout sg_ghostConnectionCallback(sg_GhostConnectionChanged);
+}
