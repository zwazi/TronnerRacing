+struct sg_GhostPlan
+{
+    unsigned long long runId;
+    tString requesterName;
+    tString displayName;
+    long long durationUs;
+    eCoord position;
+    eCoord direction;
+    REAL speed;
+    unsigned short turns;
+    std::vector< sg_GhostEvent > events;
+};
