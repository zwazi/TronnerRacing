+void gCycle::RestoreReplayEventState(
+    const eCoord &position, const eCoord &direction, REAL speed,
+    unsigned short turnCount, int turnDirection )
+{
+    if ( !IsServerGhost() || !std::isfinite(position.x) ||
+         !std::isfinite(position.y) || !std::isfinite(direction.x) ||
+         !std::isfinite(direction.y) || !std::isfinite(speed) ||
+         speed <= EPS || direction.NormSquared() <= EPS )
+        return;
+
+    pendingTurns.clear();
+    AccelerationDiscontinuity();
+    pos = position;
+    lastGoodPosition_ = pos;
+    correctPosSmooth = eCoord(0, 0);
+    correctDistanceSmooth = 0;
+    predictPosition_ = pos;
+    lastTurnPos_ = pos;
+    lastMovementStartPosition_ = pos;
+    lastMovementStartTime_ = lastTime;
+    lastMovementValid_ = false;
+    windingNumberWrapped_ = Grid()->DirectionWinding(direction);
+    dirDrive = Grid()->GetDirection(windingNumberWrapped_);
+    dir = dirDrive;
+    verletSpeed_ = speed;
+    turns = turnCount;
+    if ( turnDirection < 0 )
+        lastTurnTimeLeft_ = lastTime;
+    else
+        lastTurnTimeRight_ = lastTime;
+    refreshSpaceAhead_ = true;
+    FindCurrentFace();
+}
