+++ b/src/tron/gStartBrake.h
@@ -0,0 +1,44 @@
+#ifndef TRONNER_START_BRAKE_H
+#define TRONNER_START_BRAKE_H
+
+#include <algorithm>
+#include <cmath>
+
+// Stock clients report the resulting brake state, not the physical key. Keep
+// native braking engaged while waiting; a turn carrying that state is not a
+// release. Defer brake-off briefly because ClearKeys precedes the chat/away
+// player sync on older clients.
+class gStartBrake
+{
+public:
+    gStartBrake() : pending_(-1) {}
+    void Reset() { pending_ = -1; }
+    void Input(bool brake, bool turned, bool chatting, double now, double lag)
+    {
+        if (chatting)
+        {
+            pending_ = -1;
+            return;
+        }
+        if (brake)
+        {
+            pending_ = -1;
+        }
+        else if (!turned && pending_ < 0)
+        {
+            double wait = std::isfinite(lag) ? 2 * lag + .1 : .25;
+            wait = std::max(.25, std::min(1.0, wait));
+            pending_ = now + wait;
+        }
+    }
+    bool Ready(bool chatting, double now)
+    {
+        if (chatting)
+            pending_ = -1;
+        return pending_ >= 0 && now >= pending_;
+    }
+private:
+    double pending_;
+};
+
+#endif
